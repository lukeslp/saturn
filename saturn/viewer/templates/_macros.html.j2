{# Render a chart-fallback table inside a <details> block so screen-reader
   users get the same numbers as a sighted Plotly viewer. The macro is a
   no-op when `data` is None — every figure that can produce one will. #}
{% macro chart_fallback(data) %}
  {% if data %}
  <details class="chart-fallback">
    <summary>Show data table</summary>
    <table>
      <caption class="visually-hidden">{{ data.caption }}</caption>
      <thead><tr>{% for h in data.headers %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>
        {% for row in data.rows %}
          <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
  </details>
  {% endif %}
{% endmacro %}


{# When a previous insight pass failed, surface the reason in plain language
   so the researcher knows whether to retry or supply their own key. The
   provider's raw error message is *not* shown — we redact to a stable type
   plus a short human-readable hint. No-op when there are no errors. #}
{% macro insight_error_hint(insights) %}
  {% set errors = (insights or {}).get('errors') or [] %}
  {% if errors %}
    {% set last = errors[-1] %}
    {% set msg = (last.get('message') or '') | string %}
    {% set lower = msg.lower() %}
    {% if 'credit balance' in lower or 'credit_balance' in lower %}
      {% set hint = "The server's account is out of credits. Paste your own API key below to keep going — it's used once and never stored." %}
    {% elif 'rate limit' in lower or '429' in lower %}
      {% set hint = "The provider rate-limited the last attempt. Wait a minute and retry, or paste your own key for a fresh quota." %}
    {% elif 'authentication' in lower or 'invalid api key' in lower or 'unauthorized' in lower %}
      {% set hint = "The provider rejected the key on the last attempt. Try a different provider or paste your own key below." %}
    {% elif 'timeout' in lower or 'timed out' in lower %}
      {% set hint = "The provider timed out on the last attempt. Try again — usually transient." %}
    {% else %}
      {% set hint = "The previous attempt failed (" ~ (last.get('type') or 'unknown error') ~ "). Try again or pick a different provider." %}
    {% endif %}
    <p class="missing-error" role="status" style="border-left: 3px solid var(--hot); padding-left: 0.75rem; margin: 0 0 1rem 0; color: var(--ink);">
      <strong style="font-family: var(--font-mono); font-size: var(--size-eyebrow); letter-spacing: 0.1em; text-transform: uppercase; color: var(--hot);">last attempt failed</strong><br>
      {{ hint }}
    </p>
  {% endif %}
{% endmacro %}


{# Reusable BYOK form fields. Drop these inside any POST form that hits a
   route which calls _resolve_llm_request(). The user can paste their own
   provider key per request; the server's keys are never consulted on a
   public-facing instance. #}
{% macro byok_fields(prefix, default_provider="anthropic", compact=False) %}
  <details class="field byok"{% if not compact %} open{% endif %}>
    <summary>API key (used once, not stored)</summary>
    <label for="{{ prefix }}-llm">Provider</label>
    <select id="{{ prefix }}-llm" name="llm">
      {% for p in ["anthropic", "openai", "groq", "gemini", "mistral", "cohere"] %}
        <option value="{{ p }}"{% if p == default_provider %} selected{% endif %}>{{ p }}</option>
      {% endfor %}
    </select>
    <label for="{{ prefix }}-key">API key</label>
    <input type="password" id="{{ prefix }}-key" name="api_key" autocomplete="off" placeholder="sk-…">
  </details>
{% endmacro %}
