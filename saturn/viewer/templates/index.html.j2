{% extends "base.html.j2" %}
{% from "_macros.html.j2" import byok_fields %}
{% block title %}saturn · dataset readings{% endblock %}
{% block main %}

<section class="hero">
  <p class="eyebrow">dataset dissector · v{{ saturn_version }}</p>
  <h1>Point saturn at a dataset. Get a plain-language <em>reading</em> and every number behind it.</h1>
  <p class="lede">
    Drop a spreadsheet, CSV, JSONL, Parquet, SQLite, or Arrow file, or paste a HuggingFace
    repo id. Saturn profiles the whole corpus, then a language model writes up what changed
    and what's worth a closer look. All statistics are deterministic and machine-readable.
  </p>
</section>

<section class="inputs" aria-label="New reading">
  <form class="input-card" action="{{ url_for('analyze_file') }}" method="post" enctype="multipart/form-data">
    <div class="label"><span>UPLOAD</span><span class="count">01</span></div>
    <h2>Local file</h2>
    <label class="dropzone" id="dropzone" tabindex="0">
      <span class="subcallout">drop · or · browse</span>
      <span class="callout" id="dropzone-callout">XLSX · CSV · Parquet · SQLite · &hellip;</span>
      <span class="filename" id="dropzone-filename" aria-live="polite"></span>
      <input type="file" name="file" id="file-input"
             accept=".csv,.tsv,.jsonl,.ndjson,.json,.parquet,.feather,.arrow,.xlsx,.xls,.xlsb,.ods,.db,.sqlite,.sqlite3">
    </label>
    <p class="hint" style="margin-bottom: 0.25rem;">By default this demo runs OpenAI GPT-5.6 Luna on the server's account. Paste your own API key below to use a different provider; it's used once for this run and never stored. Pick "ollama (local)" to call a self-hosted model (only reachable when saturn runs on your own machine).</p>
    {{ byok_fields("upload", default_provider=default_llm, compact=True) }}
    <label class="checkbox">
      <input type="checkbox" name="no_llm" value="1">
      <span>stats only, skip summary</span>
    </label>
    <button class="btn" type="submit">Analyze upload</button>
    <p class="hint">50 MB max. The summary uses {{ default_llm or 'a language model' }}; uncheck "stats only" or paste your own key above.</p>
  </form>

  <form class="input-card" action="{{ url_for('analyze_hf_route') }}" method="post">
    <div class="label"><span>HUGGINGFACE</span><span class="count">02</span></div>
    <h2>Remote repo</h2>
    <div class="field">
      <label for="hf-repo">Repo id</label>
      <input type="text" id="hf-repo" name="repo" placeholder="user/dataset" required pattern="[A-Za-z0-9_.\-]+/[A-Za-z0-9_.\-]+">
    </div>
    {{ byok_fields("hf", default_provider=default_llm, compact=True) }}
    <label class="checkbox">
      <input type="checkbox" name="no_llm" value="1">
      <span>stats only, skip summary</span>
    </label>
    <button class="btn" type="submit">Analyze repo</button>
    <p class="hint">Loads every split, concatenated. Big repos may take minutes; you'll get a job page to watch.</p>
  </form>
</section>

<section class="readings" aria-label="Existing readings">
  <header>
    <h2>Readings</h2>
    <span class="count" id="readings-count">{{ "%03d" | format(docs|length) }} files</span>
  </header>

  {% if docs %}
  {# Auto-derive collections from slug prefix. Only show prefixes that appear
     ≥3 times; fewer than that and the chip is noise rather than navigation. #}
  {% set _collections = {} %}
  {% for d in docs %}
    {% set parts = d.id.split('-') %}
    {% set prefix = parts[0] if parts else '' %}
    {% if prefix and prefix.replace('_', '').isalpha() %}
      {% if _collections.update({prefix: _collections.get(prefix, 0) + 1}) %}{% endif %}
    {% endif %}
  {% endfor %}
  {% set _ranked = (_collections.items() | list | sort(attribute=1, reverse=true)) %}
  {% set _shown = _ranked | selectattr(1, 'ge', 3) | list %}

  {% if _shown %}
  <nav class="readings-collections" aria-label="Browse by collection">
    <span class="collections-label">collections</span>
    {% for prefix, count in _shown[:12] %}
      <button type="button" class="collection-chip" data-collection="{{ prefix }}">
        {{ prefix.replace('_', ' ') }}
        <span class="muted" style="font-variant-numeric: tabular-nums;">{{ count }}</span>
      </button>
    {% endfor %}
  </nav>
  {% endif %}

  <div class="readings-controls" role="search" aria-label="Filter readings">
    <label class="visually-hidden" for="readings-filter">Filter by name or source</label>
    <input type="search"
           id="readings-filter"
           placeholder="Filter by name or source… (try: language · firehose · accessibility)"
           autocomplete="off"
           inputmode="search">
    <fieldset class="readings-kind">
      <legend class="visually-hidden">Kind</legend>
      <label><input type="radio" name="kind" value="all" checked> all</label>
      <label><input type="radio" name="kind" value="profile"> profile</label>
      <label><input type="radio" name="kind" value="compare"> compare</label>
      <label><input type="radio" name="kind" value="reading"> with summary</label>
      <label><input type="radio" name="kind" value="notes"> with notes</label>
    </fieldset>
  </div>

  <div id="readings-list" data-page-size="50">
    {% for d in docs %}
      {% set has_insights = d.raw.get('insights') and d.raw['insights'].get('insights') %}
      {% set first_insight = has_insights and d.raw['insights']['insights'][0] or None %}
      {% set role_mix = {} %}
      {% if has_insights %}
        {% for ins in d.raw['insights']['insights'] if ins.get('role') %}
          {% if role_mix.update({ins.role: role_mix.get(ins.role, 0) + 1}) %}{% endif %}
        {% endfor %}
      {% endif %}
      {% set col_count = (d.columns | length) if d.kind.value == 'profile' else (d.raw.columns | length) %}
      <article class="reading"
               data-name="{{ d.id }}"
               data-kind="{{ d.kind.value }}"
               data-source="{{ d.meta.source if d.kind.value == 'profile' else (d.a_label ~ ' vs ' ~ d.b_label) }}"
               data-has-insight="{{ '1' if has_insights else '0' }}"
               data-has-notes="{{ '1' if d.has_notes else '0' }}">
        <div>
          <div class="numeral"><span class="numeral-current">{{ "%03d" | format(loop.index) }}</span> / {{ "%03d" | format(docs|length) }}</div>
          <div class="stamps">
            <span class="stamp">{{ d.kind.value }}</span>
            {% if has_insights %}<span class="stamp stamp--insight">reading</span>{% endif %}
            {% if d.has_notes %}<span class="stamp stamp--notes" title="Has researcher notes">notes</span>{% endif %}
          </div>
        </div>
        <div>
          <h3><a href="{{ url_for('view', id=d.id) }}">{{ d.id.replace('-', ' ').replace('_', ' ') }}</a></h3>
          <p class="source">
            {% if d.kind.value == 'profile' %}
              {{ d.meta.source }} · <strong>{{ "{:,}".format(d.meta.row_count or 0) }}</strong> rows × <strong>{{ col_count }}</strong> cols
            {% else %}
              {{ d.a_label }} ({{ "{:,}".format(d.raw.a.row_count or 0) }}) vs {{ d.b_label }} ({{ "{:,}".format(d.raw.b.row_count or 0) }}) · <strong>{{ col_count }}</strong> cols
            {% endif %}
          </p>
          {% if role_mix %}
            <p class="role-mix">
              {% for role, n in (role_mix.items() | list | sort(attribute=1, reverse=true)) %}
                <span class="chip chip-role">{{ n }}× {{ role }}</span>
              {% endfor %}
            </p>
          {% endif %}
          {% if first_insight %}
            <p class="preview">{{ first_insight.narrative }}</p>
          {% else %}
            <p class="preview" style="color: var(--muted);">
              No plain-language summary yet. Open the reading to generate one.
            </p>
          {% endif %}
        </div>
        <a class="open" href="{{ url_for('view', id=d.id) }}">Open</a>
      </article>
    {% endfor %}
  </div>

  <nav class="readings-pager" aria-label="Pagination" hidden>
    <button type="button" id="pager-prev" class="btn btn-ghost btn-small">← previous</button>
    <span id="pager-info" class="muted" style="font-family: var(--font-mono); font-size: var(--size-eyebrow); letter-spacing: 0.1em;"></span>
    <button type="button" id="pager-next" class="btn btn-ghost btn-small">next →</button>
  </nav>

  <p id="readings-empty" class="muted" hidden style="text-align: center; padding: 3rem; font-style: italic;">
    No readings match this filter.
  </p>
  {% else %}
    <div class="empty">
      <p>No readings yet. Upload a file or point at a HuggingFace repo above.</p>
    </div>
  {% endif %}
</section>

{% endblock %}
{% block foot_extra %}
<script src="{{ url_for('static', filename='dropzone.js') }}" defer></script>
<script src="{{ url_for('static', filename='index-filter.js') }}" defer></script>
{% endblock %}
