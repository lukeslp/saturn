{% extends "base.html.j2" %}
{% block title %}{{ doc.a_label }} vs {{ doc.b_label }} — saturn{% endblock %}
{% block main %}
<nav aria-label="Breadcrumb"><a href="{{ url_for('index') }}">← all findings</a></nav>
<h1>{{ doc.a_label }} <small class="muted">vs</small> {{ doc.b_label }}</h1>
<p class="muted">
  <strong>{{ doc.a_label }}:</strong> {{ "{:,}".format(doc.raw.a.row_count) }} rows &middot;
  <strong>{{ doc.b_label }}:</strong> {{ "{:,}".format(doc.raw.b.row_count) }} rows &middot;
  generated {{ doc.raw.generated_at }} &middot;
  <a href="{{ url_for('api_findings', id=doc.id) }}">raw JSON</a>
</p>

{% if doc.raw.divergences %}
<section aria-labelledby="div-heading">
  <h2 id="div-heading">Most divergent columns</h2>
  <table>
    <caption class="visually-hidden">Columns ranked by composite divergence score</caption>
    <thead>
      <tr>
        <th scope="col">Column</th>
        <th scope="col">Kind</th>
        <th scope="col">Score</th>
        <th scope="col">Signals</th>
      </tr>
    </thead>
    <tbody>
    {% for d in doc.raw.divergences %}
      <tr>
        <th scope="row"><a href="#col-{{ d.column }}">{{ d.column }}</a></th>
        <td>{{ d.kind }}</td>
        <td>{{ "%.2f" | format(d.score) }}</td>
        <td>{{ d.signals | join(", ") }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>
{% endif %}

{% for c in doc.raw.columns %}
<section id="col-{{ c.column }}" aria-labelledby="col-{{ c.column }}-heading">
  <h3 id="col-{{ c.column }}-heading">{{ c.column }} <small class="muted">({{ c.kind }})</small></h3>
  <table>
    <caption class="visually-hidden">Side-by-side stats for {{ c.column }}</caption>
    <thead>
      <tr>
        <th scope="col">Stat</th>
        <th scope="col">{{ doc.a_label }}</th>
        <th scope="col">{{ doc.b_label }}</th>
        <th scope="col">Δ</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">n</th>
        <td>{{ "{:,}".format(c.a.n) if c.a else "—" }}</td>
        <td>{{ "{:,}".format(c.b.n) if c.b else "—" }}</td>
        <td>—</td>
      </tr>
      <tr>
        <th scope="row">null rate</th>
        <td>{{ "%.1f%%" | format((c.a.null_rate or 0) * 100) if c.a else "—" }}</td>
        <td>{{ "%.1f%%" | format((c.b.null_rate or 0) * 100) if c.b else "—" }}</td>
        <td>{% if "null_rate_delta" in c.delta %}{{ "%+.1f%%" | format(c.delta["null_rate_delta"] * 100) }}{% else %}—{% endif %}</td>
      </tr>
      <tr>
        <th scope="row">unique</th>
        <td>{{ "{:,}".format(c.a.n_unique) if c.a and c.a.n_unique is not none else "—" }}</td>
        <td>{{ "{:,}".format(c.b.n_unique) if c.b and c.b.n_unique is not none else "—" }}</td>
        <td>—</td>
      </tr>
      {% for k, v in c.delta.items() if k.endswith("_delta") and k != "null_rate_delta" %}
      <tr>
        <th scope="row">{{ k }}</th>
        <td>—</td>
        <td>—</td>
        <td>{{ "%+.2f" | format(v) if v is number else v }}</td>
      </tr>
      {% endfor %}
      {% if c.delta.get("top_value_jaccard") is not none %}
      <tr>
        <th scope="row">top-value jaccard</th>
        <td colspan="2">—</td>
        <td>{{ "%.2f" | format(c.delta["top_value_jaccard"]) }}</td>
      </tr>
      {% endif %}
      {% if c.delta.get("language_jaccard") is not none %}
      <tr>
        <th scope="row">language jaccard</th>
        <td colspan="2">—</td>
        <td>{{ "%.2f" | format(c.delta["language_jaccard"]) }}</td>
      </tr>
      {% endif %}
    </tbody>
  </table>
  {% if c.notes %}
  <p class="muted">{{ c.notes | join("; ") }}</p>
  {% endif %}
</section>
{% endfor %}
{% endblock %}
