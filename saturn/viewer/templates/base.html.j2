<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}saturn{% endblock %}</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='saturn.css') }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% block head_extra %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="sitehead">
    <div class="page">
      <a class="wordmark" href="{{ url_for('index') }}" aria-label="Saturn home">
        saturn<em>·</em>
      </a>
      <div class="meta" aria-hidden="true">dataset readings</div>
    </div>
  </header>
  <main id="main" tabindex="-1" class="page">
    {% with messages = get_flashed_messages(with_categories=true) %}
      {% if messages %}
        <ul class="flashes">
          {% for category, message in messages %}
            <li class="flash flash-{{ category }}">{{ message }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    {% endwith %}
    <div class="grid">
      {% block main %}{% endblock %}
    </div>
  </main>
  <footer class="sitefoot">
    <div class="page">
      <span>Saturn &middot; dataset dissector</span>
      <span>v0.2.0 · <a href="{{ url_for('styleguide') }}">style guide</a> · <a href="https://github.com/lukeslp/saturn">source</a></span>
    </div>
  </footer>
  {% block foot_extra %}{% endblock %}
</body>
</html>
